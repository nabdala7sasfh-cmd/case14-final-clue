  if(!ac && AC){
    try{
      ac=new AC();
      master=ac.createGain(); master.gain.value=muted?0:1; master.connect(ac.destination);
      musicGain=ac.createGain(); musicGain.gain.value=0; musicGain.connect(master);
    }catch(e){ac=null}
  }
  if(ac){
    try{ const s=ac.createBufferSource(); s.buffer=ac.createBuffer(1,1,22050); s.connect(ac.destination); s.start(0); }catch(e){}
    if(ac.state!=='running') ac.resume();
  }else{
    // Prime each <audio> element inside the gesture so later plays are allowed.
    Object.values(html).forEach(el=>{el.muted=true;const p=el.play();if(p&&p.then)p.then(()=>{el.pause();el.currentTime=0;el.muted=muted}).catch(()=>{el.muted=muted});});
  }
  return ac?decodeAll():Promise.resolve();
}
function play(k,vol=1){
  if(muted)return;
  if(ac&&buf[k]){
    if(ac.state!=='running')ac.resume();
    const s=ac.createBufferSource(),g=ac.createGain();s.buffer=buf[k];g.gain.value=vol;s.connect(g);g.connect(master);s.start(0);return;
  }
  const el=html[k];if(!el)return;try{el.currentTime=0;el.volume=Math.min(1,vol);const p=el.play();if(p&&p.catch)p.catch(()=>{});}catch(e){}
}
function musicStart(){
  if(ac&&buf.music){
    musicStop(0);
    musicSrc=ac.createBufferSource();musicSrc.buffer=buf.music;musicSrc.loop=true;musicSrc.connect(musicGain);musicSrc.start(0);
    const t=ac.currentTime;musicGain.gain.cancelScheduledValues(t);musicGain.gain.setValueAtTime(0,t);musicGain.gain.linearRampToValueAtTime(.75,t+1.5);
  }else if(!ac){const el=html.music;el.currentTime=0;el.volume=1;el.play().catch(()=>{});}
}
function musicLevel(v,sec=1.5){
  if(ac&&musicGain){const t=ac.currentTime;musicGain.gain.cancelScheduledValues(t);musicGain.gain.setValueAtTime(musicGain.gain.value,t);musicGain.gain.linearRampToValueAtTime(v,t+sec);}
  else if(html.music){html.music.volume=Math.max(0,Math.min(1,v));if(v===0)html.music.pause();}
}
function musicStop(sec=1.5){
  if(musicSrc){musicLevel(0,sec);const s=musicSrc;musicSrc=null;setTimeout(()=>{try{s.stop()}catch(e){}},sec*1000+100);}
  else if(!ac&&html.music&&sec===0)html.music.pause();
}
const sfx={
  beep(n){play(n===1?'beepFinal':'beep',.9);},
  whoosh(){play('whoosh',.8)},
  thud(){play('stamp',1)},
  paper(){play('paper',.8)},
  reveal(){play('reveal',.9)},
  shimmer(){play('shimmer',.6)},
  fanfare(){play('finale',1)}
};
function startDrone(){musicStart()}
function calmDrone(){musicLevel(.28)}
function stopDrone(){musicStop(1.8)}
// Resume after a phone call, lock screen or app switch.
document.addEventListener('visibilitychange',()=>{
  if(!ac)return;
  if(document.hidden){ac.suspend&&ac.suspend();}else if(started){ac.resume();}
});
['touchend','click'].forEach(e=>document.addEventListener(e,()=>{if(ac&&started&&ac.state!=='running')ac.resume();},{passive:true}));
const ICON_ON='<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M4 9v6h4l5 4V5L8 9H4z"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"/></svg>';
const ICON_OFF='<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M4 9v6h4l5 4V5L8 9H4z"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16.5 9.5l5 5M21.5 9.5l-5 5"/></svg>';
function setMute(m){
  muted=m;
  if(master)master.gain.value=m?0:1;
  Object.values(html).forEach(el=>el.muted=m);
  $('mute').innerHTML=m?ICON_OFF:ICON_ON;$('mute').setAttribute('aria-label',m?'تشغيل الصوت':'كتم الصوت');$('mute').classList.toggle('off',m);
  if(!m&&ac&&ac.state!=='running')ac.resume();
}
$('mute').onclick=()=>{ if(!ac&&!started){unlockAudio();} setMute(!muted); };
setMute(false);

/* ---------- scenes ---------- */
function show(id){document.querySelectorAll('.scene').forEach(s=>s.classList.toggle('on',s.id===id));}
function flash(){const f=$('flash');f.classList.remove('go');void f.offsetWidth;f.classList.add('go');}
function shake(el){el.classList.remove('shake');void el.offsetWidth;el.classList.add('shake');}

async function intro(){
  const txt='تم العثور على الدليل السري الأخير!';
  await wait(reduce?0:1500);
  for(let i=0;i<=txt.length;i++){$('type').textContent=txt.slice(0,i);await wait(reduce?0:55);}
  await wait(400);$('go').classList.add('show');$('hint').classList.add('show');
}
intro();

let busy=false;
$('go').onclick=async()=>{
  if(busy)return;busy=true;
  const ready=unlockAudio();started=true;$('mute').hidden=false;
  $('go').classList.remove('show');
  await Promise.race([ready,wait(2500)]);
  $('stage').classList.remove('dark');
  $('hint').classList.remove('show');
  startDrone();sfx.whoosh();
  show('s2');await wait(500);
  for(const n of [3,2,1]){
    const c=$('count'),r=$('ring');c.textContent=toAr(n);
    c.classList.remove('hit');r.classList.remove('hit');void c.offsetWidth;c.classList.add('hit');r.classList.add('hit');
    sfx.beep(n);if('vibrate' in navigator)try{navigator.vibrate(40)}catch(e){}
    await wait(1000);
  }
  flash();sfx.whoosh();
  show('s3');await wait(1000);
  $('stamp').classList.add('down');await wait(260);sfx.thud();shake($('s3'));
  await wait(1300);
  sfx.paper();$('folder').classList.add('open');
  await wait(1500);
  sfx.shimmer();show('s4');
  await wait(2600);$('toAnswer').classList.add('show');$('toAnswer').focus({preventScroll:true});
};

$('toAnswer').onclick=async()=>{
  $('toAnswer').classList.remove('show');
  calmDrone();flash();sfx.reveal();
  show('s5');
  await wait(900);$('a1').classList.add('in');sfx.shimmer();
  await wait(1100);$('a2').classList.add('in');
  await wait(1600);$('toEnd').classList.add('show');
};

$('toEnd').onclick=async()=>{
  $('toEnd').classList.remove('show');
  stopDrone();mode='gold';
  show('s6');await wait(450);sfx.thud();sfx.fanfare();shake($('s6'));
  await wait(2600);$('replay').classList.add('show');
};

$('replay').onclick=()=>{
  ['replay','toEnd','toAnswer'].forEach(id=>$(id).classList.remove('show'));
  $('folder').classList.remove('open');$('stamp').classList.remove('down');
  ['a1','a2'].forEach(id=>$(id).classList.remove('in'));
  mode='dust';busy=false;$('go').click();
};
})();
</script>


