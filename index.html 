<script>
(()=>{
const $=id=>document.getElementById(id);
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const wait=ms=>new Promise(r=>setTimeout(r,ms));
const toAr=n=>String(n).replace(/\d/g,d=>'٠١٢٣٤٥٦٧٨٩'[d]);

/* ---------- fingerprint drawing ---------- */
(function(){
  const svg=$('print');let html='';
  for(let i=0;i<13;i++){
    const rx=6+i*3.9, ry=9+i*5.4, cx=60, cy=82+i*.6;
    const gap=.35+((i*37)%7)/14;              // ridge breaks
    const a0=Math.PI*(1.05+gap*.15), a1=Math.PI*(3.0-gap*.12);
    let d='';const steps=40;
    for(let s=0;s<=steps;s++){
      const a=a0+(a1-a0)*s/steps;
      const wob=Math.sin(a*3+i)*1.1;
      const x=cx+(rx+wob)*Math.cos(a), y=cy+(ry+wob)*Math.sin(a)*(Math.sin(a)>0?.75:1);
      d+=(s?'L':'M')+x.toFixed(1)+' '+y.toFixed(1);
    }
    const len=Math.PI*(rx+ry)*1.4;
    html+=`<path d="${d}" style="stroke-dasharray:${len};stroke-dashoffset:${len};animation:draw 1.6s ${(i*.11).toFixed(2)}s ease forwards;opacity:${(.55+i*.035).toFixed(2)}"/>`;
  }
  svg.innerHTML=html;
  const st=document.createElement('style');st.textContent='@keyframes draw{to{stroke-dashoffset:0}}';document.head.appendChild(st);
})();
/* seal scallops */
(function(){let h='';for(let i=0;i<36;i++){const a=i*10*Math.PI/180;h+=`<circle cx="${(100+86*Math.cos(a)).toFixed(1)}" cy="${(100+86*Math.sin(a)).toFixed(1)}" r="9" fill="#b8913f"/>`;}$('scallop').innerHTML=h;})();

/* ---------- particle background ---------- */
const cv=$('fx'),cx=cv.getContext('2d');let W,H,P=[],mode='dust';
function size(){const r=devicePixelRatio||1;W=cv.clientWidth;H=cv.clientHeight;cv.width=W*r;cv.height=H*r;cx.setTransform(r,0,0,r,0,0);}
function setH(){const h=$('stage').clientHeight||innerHeight;document.documentElement.style.setProperty('--h',h/100+'px');}
setH();size();
['resize','orientationchange'].forEach(e=>addEventListener(e,()=>{setH();size();setTimeout(()=>{setH();size()},350)}));
if(window.visualViewport)visualViewport.addEventListener('resize',setH);
for(let i=0;i<55;i++)P.push({x:Math.random(),y:Math.random(),r:Math.random()*1.6+.3,v:Math.random()*.0006+.0002,a:Math.random()});
function loop(){
  cx.clearRect(0,0,W,H);
  for(const p of P){
    p.y-=p.v*(mode==='gold'?2:1);if(p.y<-.02){p.y=1.02;p.x=Math.random();}
    p.a+=.02;const al=.25+Math.sin(p.a)*.2;
    cx.fillStyle=mode==='gold'?`rgba(243,214,143,${al+.15})`:`rgba(62,198,255,${al})`;
    cx.beginPath();cx.arc(p.x*W,p.y*H,p.r*(mode==='gold'?1.6:1),0,7);cx.fill();
  }
  if(!reduce)requestAnimationFrame(loop);
}
loop();

/* ---------- audio: real files, unlocked inside the tap ---------- */
const FILES={music:'suspense-music',beep:'beep',beepFinal:'beep-final',whoosh:'whoosh',stamp:'stamp',paper:'paper',reveal:'reveal',shimmer:'shimmer',finale:'finale'};
const AC=window.AudioContext||window.webkitAudioContext;
let ac=null,master=null,musicGain=null,musicSrc=null,muted=false,started=false;
const buf={},raw={},html={};
// Fetch every file as soon as the page opens, so the first tap plays instantly.
const loading=Promise.all(Object.entries(FILES).map(([k,f])=>
  fetch('https://aesthetic-cupcake-32a55a.netlify.app/audio/'+f+'.mp3').then(r=>{if(!r.ok)throw 0;return r.arrayBuffer()}).then(ab=>{raw[k]=ab}).catch(()=>{})
));
// HTML <audio> fallback copies (used only if Web Audio is unavailable)
Object.entries(FILES).forEach(([k,f])=>{const el=new Audio('https://aesthetic-cupcake-32a55a.netlify.app/audio/'+f+'.mp3');el.preload='none';if(k==='music')el.loop=true;html[k]=el;});
const keepAlive=$('keepalive');

function decodeAll(){
  return loading.then(()=>Promise.all(Object.keys(raw).map(k=>new Promise(res=>{
    if(buf[k]){res();return;}
    try{ac.decodeAudioData(raw[k].slice(0),d=>{buf[k]=d;res()},()=>res());}catch(e){res()}
  }))));
}
// Must run synchronously inside the click/touch handler (Safari & Chrome rule).
function unlockAudio(){
